// 연구실 과제 예산집행 관리 시스템 — Prisma schema
// 레거시 MS Access(과제관리_new_Backup.accdb)를 정규화하여 재구축.
// SQLite 로 시작했다가 Aurora DSQL(PostgreSQL 호환, 서버리스)로 이전. enum 대신 String, 금액은 원 단위 Int.
// DSQL 제약: id 는 UUID(시퀀스 대신), 인덱스는 ASYNC, FK 는 지원하되 CASCADE 가 트랜잭션 3,000행 한도에 포함.
// 자세한 설계 배경은 legacy/ 및 프로젝트 메모리 참고.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 비목 (예산 대분류) — 정부 R&D 표준 분류 최상위
model BudgetItem {
  id           String          @id @default(uuid()) @db.Uuid
  name         String          @unique
  sortOrder    Int             @default(0)
  subItems     BudgetSubItem[]
  transactions Transaction[]
}

/// 세목 (예산 중분류)
model BudgetSubItem {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  budgetItemId         String                @db.Uuid
  budgetItem           BudgetItem            @relation(fields: [budgetItemId], references: [id])
  detailItems          BudgetDetailItem[]
  transactions         Transaction[]
  evidenceRequirements EvidenceRequirement[]

  @@unique([budgetItemId, name])
}

/// 세세목 (예산 소분류)
model BudgetDetailItem {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  budgetSubItemId String        @db.Uuid
  budgetSubItem   BudgetSubItem @relation(fields: [budgetSubItemId], references: [id])
  transactions    Transaction[]

  @@unique([budgetSubItemId, name])
}

/// 연구원 명단 — ⚠️ 민감정보(주민번호/계좌/주소) 평문 저장(현 단계 결정)
model Researcher {
  id              String    @id @default(uuid()) @db.Uuid
  employeeNo      String? // 학번/사번
  name            String // 이름
  ssn             String? // 주민등록번호
  sciTechNo       String? // 과학기술인번호
  title           String? // 직책
  affiliation     String? // 소속
  workPhone       String? // 직장전화번호
  phone           String? // 전화번호
  email           String? // 이메일
  bankName        String? // 은행명
  accountNo       String? // 계좌번호
  homeAddress     String? // 집주소
  workAddress     String? // 직장주소
  researcherRegNo String? // 연구자등록번호
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  ledProjects     Project[] @relation("PI")
}

/// 과제 (마스터) — 레거시 과제목록
model Project {
  id              String        @id @default(uuid()) @db.Uuid
  code            String?       @unique // 과제번호
  name            String // 과제명
  businessName    String? // 사업명
  piName          String? // 연구책임(텍스트, 레거시 호환)
  piId            String?       @db.Uuid // 연구책임 연구원 FK(선택)
  pi              Researcher?   @relation("PI", fields: [piId], references: [id])
  managerName     String? // 과제담당
  hostOrg         String? // 주관연구기관
  fundingAgency   String? // 지원기관
  fundBank        String? // 연구비 전용계좌 은행 — 부가세(회사 부담분) 지출결의의 입금처
  fundAccount     String? // 연구비 전용계좌 번호
  fundHolder      String? // 연구비 전용계좌 예금주
  indirectRate    Float         @default(0) // 간접징수비율(%)
  status          String? // 진행상태
  region          String? // 수행지역
  cardType        String? // 카드구분
  classification  String? // 과제분류
  category        String? // 과제구분
  researchType    String? // 연구형태
  managementGroup String? // 관리그룹
  startDate       DateTime? // 연구시작일
  endDate         DateTime? // 연구종료일
  active          Boolean       @default(true) // USE_YN
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  years           ProjectYear[]
}

/// 연차(차수/회계연도) — 레거시 "ITRC3년차" 같은 테이블 분할을 행으로 정규화
model ProjectYear {
  id           String        @id @default(uuid()) @db.Uuid
  projectId    String        @db.Uuid
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  yearNo       Int // 1,2,3 년차
  label        String? // 표시용 라벨(예: "ITRC3년차")
  fiscalYear   Int? // 회계연도
  budgetCash   Int           @default(0) // 당해연구현금(예산, 원)
  startDate    DateTime?
  endDate      DateTime?
  ledgerType   String        @default("PROJECT") // PROJECT | PERSONAL_MILEAGE | LAB_MILEAGE
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  rcmsRecords  RcmsRecord[]

  @@unique([projectId, yearNo])
}

/// 집행 내역 (원장) — 레거시 20여 개 장부 테이블을 단일 테이블로 통합
/// 잔액 = Σ(direction=IN) − Σ(direction=OUT). 세목/비목 변경은 IN+OUT 쌍거래.
model Transaction {
  id                 String              @id @default(uuid()) @db.Uuid
  projectYearId      String              @db.Uuid
  projectYear        ProjectYear         @relation(fields: [projectYearId], references: [id], onDelete: Cascade)
  date               DateTime // 날짜
  status             String              @default("신청") // 상태: 신청/완료 등
  direction          String // 입출구분: IN(입금) | OUT(출금)
  amount             Int // 공급가액(원, 항상 양수) — 연구비 집행분. 잔액 계산은 이 값만 사용
  description        String? // 적요
  vatRate            Int                 @default(10) // 부가세율(%), 면세는 0
  vatAmount          Int                 @default(0) // 부가세(원) — 회사 자금, 잔액 계산에서 항상 제외
  vendor             String? // 거래처
  vendorBank         String?
  vendorAccount      String?
  vendorHolder       String?
  purpose            String? // 구매 사유(과제와의 직접적 관련성)
  paymentMethod      String? // 연구비카드 | RCMS 계좌이체
  deliveryDate       DateTime? // 납품일
  inspectionDate     DateTime? // 검수일
  installLocation    String? // 설치(납품)장소 — 검수확인서 표기
  paymentDueDate     DateTime? // 지급기한
  budgetItemId       String?             @db.Uuid
  budgetItem         BudgetItem?         @relation(fields: [budgetItemId], references: [id])
  budgetSubItemId    String?             @db.Uuid
  budgetSubItem      BudgetSubItem?      @relation(fields: [budgetSubItemId], references: [id])
  budgetDetailItemId String?             @db.Uuid
  budgetDetailItem   BudgetDetailItem?   @relation(fields: [budgetDetailItemId], references: [id])
  plannedAmount      Int? // 품의 시점 공급가액 — RCMS 매칭으로 amount 가 실집행액으로 갱신될 때 보존
  seqNo              Int? // 연차 안의 거래 연번(1부터, 생성 순). 첨부 파일명 "01-…" 의 번호. 삭제돼도 재사용하지 않음
  budgetAdjust       Boolean? // 편성 조정 기록(협약변경 비목 재배분 등): IN=증액, OUT=감액. 집행·RCMS 대조에서 빠지고 편성액에만 반영. 기존 레코드는 고치지 않고 이 조정 레코드를 추가한다
  attachments        Attachment[]
  items              TransactionItem[]
  documents          GeneratedDocument[]
  rcmsRecord         RcmsRecord?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([projectYearId])
  @@index([budgetItemId])
  @@index([date])
  @@index([projectYearId, seqNo])
}

/// RCMS "연구비 이체 실행 대상 목록" 엑셀에서 가져온 사용등록 건 — 실행된 집행의 원본(source of truth).
/// RCMS 는 고유 ID 를 내보내지 않으므로 key 는 (과제번호·등록일시·사용일자·사용금액·거래처·품목) 해시.
model RcmsRecord {
  id            String       @id @default(uuid()) @db.Uuid
  key           String       @unique
  projectYearId String       @db.Uuid
  projectYear   ProjectYear  @relation(fields: [projectYearId], references: [id], onDelete: Cascade)
  transactionId String?      @unique @db.Uuid // 매칭된 품의(우리 장부 거래)
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  matchMethod   String? // auto | manual | created
  rcmsProjectNo String // 과제번호
  stage         String? // 단계
  yearNo        Int? // 연차
  registeredAt  DateTime? // 등록일시
  useDate       DateTime? // 사용일자
  progress      String? // 진행상태 (임시저장/등록 …)
  execStatus    String? // 집행상태
  evidenceType  String? // 증빙구분 (연구비전용카드/전자세금계산서 …)
  budgetPath    String? // 비목정보 "직접비>연구재료비>연구재료 구입비"
  useAmount     Int          @default(0) // 사용금액(총액)
  supplyAmount  Int          @default(0) // 공급금액
  vatAmount     Int          @default(0) // 부가세액
  vendor        String? // 거래처명
  vendorBizNo   String? // 거래처 사업자등록번호
  bank          String? // 입금은행
  account       String? // 입금계좌번호
  holder        String? // 예금주명
  purpose       String? // 지급용도
  regType       String? // 등록구분 (증빙우선/비목우선)
  execStage     String? // 집행단계
  itemName      String? // 품목명
  raw           String // 원본 행 JSON (헤더→값)
  firstSeenAt   DateTime     @default(now())
  lastSeenAt    DateTime     @default(now())
  missingSince  DateTime? // 최근 가져오기 목록에서 사라진 시점 → 이체 실행 완료로 추정

  @@index([projectYearId])
}

/// RCMS 엑셀 가져오기 이력
model RcmsImport {
  id           String   @id @default(uuid()) @db.Uuid
  fileName     String
  rowCount     Int
  newCount     Int
  updatedCount Int
  missingCount Int
  matchedCount Int      @default(0)
  skipped      String? // 매핑 실패 사유 요약 JSON
  importedAt   DateTime @default(now())
}

/// 증빙 첨부 — Access 첨부필드 대체, 파일은 디스크에 저장
model Attachment {
  id            String      @id @default(uuid()) @db.Uuid
  transactionId String      @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  fileName      String // 표시·다운로드 파일명 — 규칙 "연번-증빙종류-거래처-비목.ext" 로 자동 부여
  originalName  String? // 업로드 당시 원본 파일명(정규화만 적용)
  storedName    String // 저장 파일명(디스크, UUID)
  mimeType      String?
  size          Int         @default(0)
  evidenceCode  String? // 증빙 유형 태그 (EvidenceRequirement.code)
  uploadedAt    DateTime    @default(now())
}

/// 거래 품목 — 품의서·검수확인서 표에 들어가는 라인아이템
model TransactionItem {
  id            String      @id @default(uuid()) @db.Uuid
  transactionId String      @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  name          String // 품목명
  spec          String? // 규격
  quantity      Int         @default(1)
  unitPrice     String      @default("0") // 단가(원) — 소수 2자리까지의 십진 문자열(예 "33333.33"). 부동소수점 금지 규칙에 따라 TEXT 로 저장하고 계산은 정수 스케일링(src/lib/money.ts)
  amount        Int         @default(0) // quantity × unitPrice 를 원 단위로 반올림 (정수 연산)
  sortOrder     Int         @default(0)

  @@index([transactionId])
}

/// 생성 서류 — 품의서 / 검수확인서 / 지출결의 본문 / 예산·연구원 대비표
model GeneratedDocument {
  id            String       @id @default(uuid()) @db.Uuid
  transactionId String?      @db.Uuid
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  projectYearId String?      @db.Uuid // 대비표 등 연차 단위 서류
  templateCode  String // PURCHASE_REQUEST | INSPECTION_CERT | EXPENSE_REPORT | EXPENSE_REPORT_VAT | BUDGET_DIFF | RESEARCHER_DIFF
  format        String // text | pdf
  content       String? // text 본문
  filePath      String? // pdf: UPLOAD_DIR 기준 상대경로 (generated/{txId}/...)
  createdAt     DateTime     @default(now())

  @@index([transactionId])
  @@index([projectYearId])
}

/// 세목별 필수 증빙 요건 (seed) — requirement: required | one_of | optional
model EvidenceRequirement {
  id              String        @id @default(uuid()) @db.Uuid
  budgetSubItemId String        @db.Uuid
  budgetSubItem   BudgetSubItem @relation(fields: [budgetSubItemId], references: [id], onDelete: Cascade)
  code            String // TAX_INVOICE, CARD_SLIP, STATEMENT, PURCHASE_REQUEST, INSPECTION_CERT, ...
  label           String
  requirement     String // required | one_of | optional
  groupKey        String? // one_of 그룹 (예: receipt = 세금계산서|카드매출전표)
  sortOrder       Int           @default(0)

  @@unique([budgetSubItemId, code])
}
